# ---------------------------------------------------------------------------
# Frontend (Vite) — these ship to the browser, so use the ANON key only.
# Protect data with Supabase row-level security, never by hiding this key.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the Python story backend (merged_app.py) is running.
# Story generation is disabled in the UI when this is unset.
VITE_STORY_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Backend (merged_app.py) — server-side only. NEVER expose these to the client.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which LLM generates the stories: "openai" or "anthropic"
STORY_PROVIDER=openai

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...        # only needed when STORY_PROVIDER=anthropic

CORS_ALLOW_ORIGINS=http://localhost:5173
